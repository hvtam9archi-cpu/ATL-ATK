<Window x:Class="ATL_ATK.UI.AtkOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Thiết lập chọn, sắp xếp Block Att"
        Width="440" SizeToContent="Height" MaxHeight="700" d:DesignWidth="440"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize" Height="530">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Title Bar -->
            <Border Grid.Row="0" Background="{DynamicResource TitleBarBrush}" CornerRadius="10,10,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Column="0" Margin="10,0">
                        <Border Width="20" Height="20" CornerRadius="4" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                            <TextBlock Text="A" Foreground="White" FontWeight="Bold" FontFamily="Segoe UI" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding Path=Title, RelativeSource={RelativeSource AncestorType=Window}}" 
                                   Foreground="{DynamicResource FgBrush}" 
                                   FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" 
                                   VerticalAlignment="Center" Margin="8,0"/>
                    </StackPanel>

                    <Button Grid.Column="1" Content="✕" Width="32" Height="26" Padding="0"
                            Background="#FF6F4949" BorderThickness="0" 
                            Click="BtnCloseWindow_Click" VerticalAlignment="Center" HorizontalAlignment="Right"
                            Foreground="{DynamicResource DangerBrush}" FontWeight="Bold" Margin="2,2,8,2"/>
                </Grid>
            </Border>

            <!-- Row 1: Content -->
            <Grid Grid.Row="1" Margin="16">
                <StackPanel>
                    <!-- Cách chọn Block -->
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Cách chọn Block" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>
                            <Grid Height="53" Width="376">
                                <RadioButton x:Name="RdManual" Content="Chọn thủ công" GroupName="SelectMode" Margin="0,0,0,38"/>
                                <RadioButton x:Name="RdByLayout" Content="Theo Layout (trừ Model)" GroupName="SelectMode" Margin="0,21,0,17"/>
                                <RadioButton x:Name="RdAll" Content="Tất cả (bao gồm Model)" GroupName="SelectMode" Margin="0,42,0,-4"/>
                            </Grid>
                            <Separator Margin="0,6"/>
                            <RadioButton x:Name="RdOneBlock" Content="Chỉ 1 loại Block" GroupName="BlockFilter" Margin="2"/>
                            <RadioButton x:Name="RdMultiBlock" Content="Nhiều loại Block" GroupName="BlockFilter" Margin="2"/>
                        </StackPanel>
                    </Border>

                    <!-- Sắp xếp -->
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Sắp xếp" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>

                            <CheckBox x:Name="ChkSortPos" Content="Sắp xếp theo vị trí (tọa độ)" Margin="2"
                                      Checked="ChkSortPos_Changed" Unchecked="ChkSortPos_Changed"/>

                            <Grid Margin="20,4,0,0" x:Name="PnlSortPos">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>

                                <Label Content="Hướng chính:" Grid.Row="0" Grid.Column="0"/>
                                <ComboBox x:Name="CmbSortDir1" Grid.Row="0" Grid.Column="1" Margin="2"/>

                                <Label Content="Hướng phụ:" Grid.Row="1" Grid.Column="0"/>
                                <ComboBox x:Name="CmbSortDir2" Grid.Row="1" Grid.Column="1" Margin="2"/>

                                <Label Content="Dung sai:" Grid.Row="2" Grid.Column="0"/>
                                <TextBox x:Name="TxtSortFuzz" Grid.Row="2" Grid.Column="1" 
                                         Width="80" HorizontalAlignment="Left" Margin="2"/>
                            </Grid>

                            <Separator Margin="0,6"/>

                            <CheckBox x:Name="ChkSortCol" Content="Sắp xếp theo giá trị cột" Margin="2"
                                      Checked="ChkSortCol_Changed" Unchecked="ChkSortCol_Changed"/>

                            <DockPanel Margin="20,4,0,0" x:Name="PnlSortCol">
                                <Label Content="Cột:"/>
                                <ComboBox x:Name="CmbSortColIdx" Width="221" Margin="2"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Row 2: Bottom Bar -->
            <Border Grid.Row="2" Background="{DynamicResource TitleBarBrush}" CornerRadius="0,0,10,10" Padding="14,8">
                <Grid>
                    <Button Content="Update Table" HorizontalAlignment="Left" Width="110" Height="34" 
                            Click="BtnUpdateTable_Click" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource SuccessBrush}" ToolTip="Cập nhật lại toàn bộ bảng đã tạo theo số lượng Block hiện có trên bản vẽ." Margin="2,0,2,0"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Width="90" Height="34" IsCancel="True" Margin="0,0,6,0"
                                Click="BtnCancel_Click" Background="{DynamicResource SurfaceBrush}"/>
                        <Button Content="OK" Width="120" Height="34" IsDefault="True"
                                Click="BtnOk_Click" Background="{DynamicResource AccentBrush}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Top" Margin="2,0,2,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
