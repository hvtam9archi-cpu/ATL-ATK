<Window x:Class="ATL_ATK.UI.AtkOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thiết lập chọn, sắp xếp Block Att"
        Width="440" Height="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F0F0F0">

    <DockPanel Margin="8">

        <!-- Bottom Buttons -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" 
                    HorizontalAlignment="Center" Margin="0,8,0,0">
            <Button Content="OK" Width="90" IsDefault="True" Margin="4" Padding="6,4"
                    Click="BtnOk_Click"/>
            <Button Content="Cancel" Width="90" IsCancel="True" Margin="4" Padding="6,4"
                    Click="BtnCancel_Click"/>
        </StackPanel>

        <StackPanel>
            <!-- Cách chọn Block -->
            <GroupBox Header="Cách chọn Block" Margin="0,2" Padding="6">
                <StackPanel>
                    <RadioButton x:Name="RdManual" Content="Chọn thủ công" GroupName="SelectMode" Margin="2"/>
                    <RadioButton x:Name="RdByLayout" Content="Theo Layout (trừ Model)" GroupName="SelectMode" Margin="2"/>
                    <RadioButton x:Name="RdAll" Content="Tất cả (bao gồm Model)" GroupName="SelectMode" Margin="2"/>
                    <Separator Margin="0,6"/>
                    <RadioButton x:Name="RdOneBlock" Content="Chỉ 1 loại Block" GroupName="BlockFilter" Margin="2"/>
                    <RadioButton x:Name="RdMultiBlock" Content="Nhiều loại Block" GroupName="BlockFilter" Margin="2"/>
                </StackPanel>
            </GroupBox>

            <!-- Sắp xếp -->
            <GroupBox Header="Sắp xếp" Margin="0,2" Padding="6">
                <StackPanel>
                    <CheckBox x:Name="ChkSortPos" Content="Sắp xếp theo vị trí (tọa độ)" Margin="2"
                              Checked="ChkSortPos_Changed" Unchecked="ChkSortPos_Changed"/>

                    <Grid Margin="20,4,0,0" x:Name="PnlSortPos">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <Label Content="Hướng chính:" Grid.Row="0" Grid.Column="0"/>
                        <ComboBox x:Name="CmbSortDir1" Grid.Row="0" Grid.Column="1" Margin="2"/>

                        <Label Content="Hướng phụ:" Grid.Row="1" Grid.Column="0"/>
                        <ComboBox x:Name="CmbSortDir2" Grid.Row="1" Grid.Column="1" Margin="2"/>

                        <Label Content="Dung sai:" Grid.Row="2" Grid.Column="0"/>
                        <TextBox x:Name="TxtSortFuzz" Grid.Row="2" Grid.Column="1" 
                                 Width="80" HorizontalAlignment="Left" Margin="2"/>
                    </Grid>

                    <Separator Margin="0,6"/>

                    <CheckBox x:Name="ChkSortCol" Content="Sắp xếp theo giá trị cột" Margin="2"
                              Checked="ChkSortCol_Changed" Unchecked="ChkSortCol_Changed"/>

                    <DockPanel Margin="20,4,0,0" x:Name="PnlSortCol">
                        <Label Content="Cột:"/>
                        <ComboBox x:Name="CmbSortColIdx" Width="60" HorizontalAlignment="Left" Margin="2"/>
                    </DockPanel>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </DockPanel>
</Window>
