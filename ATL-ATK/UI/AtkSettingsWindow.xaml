<Window x:Class="ATL_ATK.UI.AtkSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Thống kê Block Att, Dynamic (AutoCAD Table) v1.06"
        Width="720" SizeToContent="Height" MaxHeight="800"
        d:DesignHeight="700" d:DesignWidth="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Title Bar -->
            <Border Grid.Row="0" Background="{DynamicResource TitleBarBrush}" CornerRadius="10,10,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Orientation="Horizontal" Grid.Column="0" Margin="10,0">
                        <Border Width="20" Height="20" CornerRadius="4" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                            <TextBlock Text="A" Foreground="White" FontWeight="Bold" FontFamily="Segoe UI" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding Path=Title, RelativeSource={RelativeSource AncestorType=Window}}" 
                                   Foreground="{DynamicResource FgBrush}" 
                                   FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" 
                                   VerticalAlignment="Center" Margin="8,0"/>
                    </StackPanel>

                    <Button Grid.Column="1" Content="✕" Width="32" Height="26" Padding="0"
                            Background="Transparent" BorderThickness="0" 
                            Click="BtnCloseWindow_Click" VerticalAlignment="Top" HorizontalAlignment="Right"
                            Foreground="{DynamicResource FgBrush}"/>
                </Grid>
            </Border>

            <!-- Row 1: Content -->
            <Grid Grid.Row="1" Margin="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,6,0">

                        <!-- Row 1: Block Declaration + Tag List + Presets -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Khai báo Block -->
                            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="Khai báo Block" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>
                                    <Button x:Name="BtnSelectBlock" Content="Chọn Block Att" Click="BtnSelectBlock_Click"/>
                                    <TextBlock x:Name="TxtBlockName" Text="Nothing selected" Margin="4" Foreground="Gray"/>
                                </StackPanel>
                            </Border>

                            <!-- Danh sách Tag -->
                            <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="6,0,6,0">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Danh sách Tag" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>
                                    <Button DockPanel.Dock="Top" Content="Copy" Click="BtnCopyTag_Click" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                    <ListBox x:Name="LstTags" Height="90" Margin="2" Background="Transparent" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"/>
                                </DockPanel>
                            </Border>

                            <!-- Cài đặt sẵn -->
                            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Cài đặt sẵn" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>
                                    <Button Content="Save" Click="BtnSaveSettings_Click"/>
                                    <Button Content="Load" Click="BtnLoadSettings_Click"/>
                                    <Button Content="Default" Click="BtnDefault_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Row 2: Thiết lập bảng -->
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Thiết lập bảng" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="220"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <DockPanel Margin="2">
                                            <Label Content="Table Style" Width="80"/>
                                            <ComboBox x:Name="CmbTableStyle"/>
                                        </DockPanel>
                                        <DockPanel Margin="2">
                                            <Label Content="Text Style" Width="80"/>
                                            <ComboBox x:Name="CmbTextStyle"/>
                                        </DockPanel>
                                        <DockPanel Margin="2">
                                            <Label Content="Tiêu đề" Width="80"/>
                                            <TextBox x:Name="TxtTitle"/>
                                        </DockPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <DockPanel Margin="2">
                                            <Label Content="Cao chữ" Width="70"/>
                                            <TextBox x:Name="TxtTextHeight" Width="60" HorizontalAlignment="Left"/>
                                        </DockPanel>
                                        <DockPanel Margin="2">
                                            <Label Content="Cao hàng" Width="70"/>
                                            <TextBox x:Name="TxtRowHeight" Width="60" HorizontalAlignment="Left"/>
                                        </DockPanel>
                                        <CheckBox x:Name="ChkAutoColumn" Content="Hàng cột tự động" Margin="6,4"/>
                                        <CheckBox x:Name="ChkShowSum" Content="Thêm hàng tính tổng" Margin="6,4"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Row 3: Nội dung cột -->
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Nội dung cột" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>
                                
                                <!-- Toolbar -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="Hướng dẫn cách nhập Tag" Click="BtnTips_Click"/>
                                    <Button Content="Thêm cột" Click="BtnAddColumn_Click"/>
                                    <Button Content="Bớt cột" Click="BtnRemoveColumn_Click"/>
                                </StackPanel>

                                <!-- Column definitions (dynamic) -->
                                <ItemsControl x:Name="ColumnItems">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="65"/>
                                                </Grid.ColumnDefinitions>
                                                <Label Content="{Binding Header}" Grid.Column="0" Width="65"/>
                                                <TextBox Text="{Binding TagExpression, UpdateSourceTrigger=PropertyChanged}" 
                                                         Grid.Column="1"/>
                                                <Label Content="Tên cột" Grid.Column="2"/>
                                                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" 
                                                         Grid.Column="3"/>
                                                <Label Content="Rộng" Grid.Column="4"/>
                                                <TextBox Text="{Binding WidthText, UpdateSourceTrigger=PropertyChanged}" 
                                                         Grid.Column="5"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Row 2: Bottom Bar -->
            <Border Grid.Row="2" Background="{DynamicResource TitleBarBrush}" CornerRadius="0,0,10,10" Padding="14,8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Info" Width="90" Height="34" Margin="0,0,6,0" Click="BtnInfo_Click" Background="{DynamicResource SurfaceBrush}"/>
                    <Button Content="Cancel" Width="90" Height="34" IsCancel="True" Margin="0,0,6,0" Click="BtnCancel_Click" Background="{DynamicResource SurfaceBrush}"/>
                    <Button Content="OK" Width="120" Height="34" IsDefault="True" Click="BtnOk_Click" Background="{DynamicResource AccentBrush}" Foreground="White" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
