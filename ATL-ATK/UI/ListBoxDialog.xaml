<Window x:Class="ATL_ATK.UI.ListBoxDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chọn mục"
        Width="320" Height="350"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F0F0F0">

    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" 
                    HorizontalAlignment="Center" Margin="0,8,0,0">
            <Button Content="OK" Width="80" IsDefault="True" Margin="4" Padding="6,4"
                    Click="BtnOk_Click"/>
            <Button Content="Cancel" Width="80" IsCancel="True" Margin="4" Padding="6,4"
                    Click="BtnCancel_Click"/>
        </StackPanel>

        <ListBox x:Name="LstItems" Margin="4"
                 SelectionMode="Extended"/>
    </DockPanel>
</Window>
